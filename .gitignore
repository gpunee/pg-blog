# Hugo build output — regenerated by `hugo`; never commit
/public/
/resources/
.hugo_build.lock

# Hugo local caches
/.hugo_cache/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Syndication tool (Python) — venv + local secrets
scripts/syndicate/venv/
scripts/syndicate/.env

# Python bytecode cache (standard hygiene, not project-specific)
__pycache__/
*.pyc

# Syndication generated output (regenerable via `run.sh medium` / `run.sh teasers`)
scripts/syndication/

# Project-local operating manual — intentionally untracked (per owner)
/CLAUDE.md
